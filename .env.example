# Token do bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Client ID da aplicação (Discord Developer Portal > General Information)
CLIENT_ID=

# ID do servidor (Discord) onde os slash commands serão registrados.
# Deixe em branco pra registrar globalmente (demora até 1h pra propagar).
GUILD_ID=

# Porta que a API HTTP de validação vai escutar
API_PORT=3000

# Segredo exigido pra chamar /validate (header X-API-Key ou ?secret=).
# Deixe vazio pra desativar (não recomendado — qualquer um na internet
# consegue chamar a API sem isso). Gere algo aleatório e longo.
API_SECRET=

# Chave secreta simples pra proteger os comandos de admin no bot.
# Qualquer usuário com esse cargo (ID do cargo do Discord) pode usar
# comandos administrativos (/key generate, /key revoke, /config).
ADMIN_ROLE_ID=

# Access Token do Mercado Pago (mercadopago.com.br/developers > Suas
# integrações > credenciais de PRODUÇÃO). Deixe vazio pra desativar o
# Pix automático — nesse caso, o ticket usa só o botão manual de
# "Confirmar Pagamento" que já existia antes.
MERCADOPAGO_ACCESS_TOKEN=

# Token da API do PushinPay (pushinpay.com.br/developers). Se preenchido,
# tem PRIORIDADE sobre o Mercado Pago pro Pix automático — é mais simples
# de configurar (não pede conta empresarial verificada).
PUSHINPAY_API_TOKEN=

# Senha do dashboard privado (o painel web no Vercel). Deixe vazio pra
# desativar o dashboard inteiro (todas as rotas /dashboard/* respondem
# 401/503). Escolhe uma senha forte, tipo uma frase aleatória longa.
DASHBOARD_PASSWORD=

# URL do seu dashboard no Vercel (ex: https://meu-dashboard.vercel.app).
# Deixe vazio pra liberar CORS de qualquer origem (ok pra testar, mas
# trave isso pra sua URL exata assim que souber ela).
DASHBOARD_ALLOWED_ORIGIN=
